# TRACE Environment Variables Configuration

# Copy this file to .env and configure with your credentials.
# Do NOT commit the .env file to Git.

# 1. Blockchain Deployment and Network Safety
# For Local Node:
# EXPECTED_CHAIN_ID=31337
# For Polygon Amoy:
# EXPECTED_CHAIN_ID=80002
EXPECTED_CHAIN_ID=31337

# Deployed Smart Contract Address (from deployment scripts)
TRACE_CONTRACT_ADDRESS=

# Configured Agent Address (wallet address that signs attestations)
TRACE_AGENT_ADDRESS=

# 2. Polygon Amoy Credentials (required for testnet deployment/transactions)
PRIVATE_KEY=
POLYGON_AMOY_RPC_URL=

# 3. Gemini LLM API Configuration
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
